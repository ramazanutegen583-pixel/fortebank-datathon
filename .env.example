APP_API_KEY=replace-with-a-private-random-key
APP_HOST=127.0.0.1
APP_PORT=8000
APP_MAX_UPLOAD_MB=100
APP_MAX_PENDING_JOBS=8
APP_JOB_TIMEOUT_SECONDS=270
APP_UPLOAD_TIMEOUT_SECONDS=120
APP_MAX_EVIDENCE_MB=8
APP_TEST_MODE=0
# APP_RUNTIME_DIR=/absolute/path/to/local/storage
# Default analyzer: vision.pipeline:analyze_video
VISION_DEVICE=cuda
VISION_QUANTIZATION=none
VISION_INPUT_MODE=video
VISION_QUANTIZE_VISION=0
VISION_OFFLOAD_VISUAL=1
# VISION_MODEL_DIR=/absolute/path/to/models/qwen3-vl-2b
VISION_CONFIDENCE_THRESHOLD=0.8
VISION_MAX_FRAME_PIXELS=524288
VISION_BUDGET_SECONDS=235
