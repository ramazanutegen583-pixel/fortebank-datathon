{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortebank-datathon:analysis:v1",
  "title": "Local analyzer output v1",
  "type": "object",
  "required": [
    "verdict",
    "violations"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "violation",
        "no_violation"
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "violation"
          }
        }
      },
      "then": {
        "properties": {
          "violations": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "violations": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "document_title",
        "section",
        "url",
        "rationale"
      ],
      "properties": {
        "document_title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": [
        "timestamp_sec",
        "image_path"
      ],
      "properties": {
        "timestamp_sec": {
          "type": "number",
          "minimum": 0
        },
        "image_path": {
          "type": "string",
          "minLength": 5,
          "pattern": "^[^\\\\]+\\.(jpg|jpeg)$"
        }
      },
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames",
        "sources"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "timecode_sec": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
