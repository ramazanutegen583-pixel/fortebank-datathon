{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortebank-datathon:api:v1",
  "title": "ForteBank job response v1",
  "oneOf": [
    {
      "$ref": "#/$defs/processing"
    },
    {
      "$ref": "#/$defs/completed"
    },
    {
      "$ref": "#/$defs/failed"
    }
  ],
  "$defs": {
    "submission": {
      "type": "object",
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "properties": {
        "timestamp_sec": {
          "type": "number",
          "minimum": 0
        },
        "image_base64": {
          "type": "string",
          "minLength": 4,
          "contentEncoding": "base64",
          "contentMediaType": "image/jpeg"
        }
      },
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "timecode_sec": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": [
        "job_id",
        "status"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "processing"
        }
      },
      "additionalProperties": false
    },
    "completed": {
      "type": "object",
      "required": [
        "job_id",
        "status",
        "verdict",
        "violations"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "done"
        },
        "verdict": {
          "enum": [
            "violation",
            "no_violation"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/violation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "violation"
              }
            }
          },
          "then": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "failed": {
      "type": "object",
      "required": [
        "job_id",
        "status",
        "error"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
